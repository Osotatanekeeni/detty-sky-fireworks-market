# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key — safe in the browser; RLS protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key — SERVER ONLY. In production set it as a Cloudflare Worker secret:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (Paystack → Settings → API Keys & Webhooks). SERVER ONLY. ──
# Test key (sk_test_…) until launch. Webhook URL: https://<domain>/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Local development without Paystack: set to 1 and leave PAYSTACK_SECRET_KEY empty — checkout
# "pays" instantly. Ignored in production builds.
PAYSTACK_SIMULATE=

# ── Email (Resend). SERVER ONLY. Without a key, emails are logged instead of sent. ──
RESEND_API_KEY=
EMAIL_FROM="Detty Sky <orders@dettysky.ng>"

# Public site URL for Paystack callbacks and email links (no trailing slash).
SITE_URL=http://localhost:8080
